# THE ONE PLACE TO PUT SECRET KEYS.
# Copy to supabase/.env, fill in, then run once:
#   supabase secrets set --env-file supabase/.env
# The keys then work for every user and are never shipped inside the app.

# https://spoonacular.com/food-api  (optional; TheMealDB is used when empty)
SPOONACULAR_API_KEY=

# https://aistudio.google.com/apikey  (optional; enables the AI fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
